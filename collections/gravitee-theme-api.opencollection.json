{
  "opencollection": "1.0.0",
  "info": {
    "name": "Gravitee.io - Access Management alerts theme API",
    "version": "4.12.0-alpha.3"
  },
  "items": [
    {
      "info": {
        "name": "theme",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List themes on the specified security domain",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/management/organizations/:organizationId/environments/:environmentId/domains/:domain/themes",
            "params": [
              {
                "name": "organizationId",
                "value": "",
                "type": "path"
              },
              {
                "name": "environmentId",
                "value": "",
                "type": "path"
              },
              {
                "name": "domain",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "User must have the DOMAIN_THEME[LIST] permission on the specified domain or DOMAIN_THEME[LIST] permission on the specified environment or DOMAIN_THEME[LIST] permission on the specified organization"
        },
        {
          "info": {
            "name": "Create a theme on the specified security domain",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "/management/organizations/:organizationId/environments/:environmentId/domains/:domain/themes",
            "params": [
              {
                "name": "organizationId",
                "value": "",
                "type": "path"
              },
              {
                "name": "environmentId",
                "value": "",
                "type": "path"
              },
              {
                "name": "domain",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "User must have the DOMAIN_THEME[CREATE] permission on the specified domain or DOMAIN_THEME[CREATE] permission on the specified environment or DOMAIN_THEME[CREATE] permission on the specified organization"
        },
        {
          "info": {
            "name": "Get the theme linked to the specified security domain",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/management/organizations/:organizationId/environments/:environmentId/domains/:domain/themes/:themeId",
            "params": [
              {
                "name": "organizationId",
                "value": "",
                "type": "path"
              },
              {
                "name": "environmentId",
                "value": "",
                "type": "path"
              },
              {
                "name": "domain",
                "value": "",
                "type": "path"
              },
              {
                "name": "themeId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "User must have the DOMAIN_THEME[READ] permission on the specified domain or DOMAIN_THEME[READ] permission on the specified environment or DOMAIN_THEME[READ] permission on the specified organization"
        },
        {
          "info": {
            "name": "Update a theme on the specified security domain",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "/management/organizations/:organizationId/environments/:environmentId/domains/:domain/themes/:themeId",
            "params": [
              {
                "name": "organizationId",
                "value": "",
                "type": "path"
              },
              {
                "name": "environmentId",
                "value": "",
                "type": "path"
              },
              {
                "name": "domain",
                "value": "",
                "type": "path"
              },
              {
                "name": "themeId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "User must have the DOMAIN_THEME[UPDATE] permission on the specified domain or DOMAIN_THEME[UPDATE] permission on the specified environment or DOMAIN_THEME[UPDATE] permission on the specified organization"
        },
        {
          "info": {
            "name": "Delete a theme on the specified security domain",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "/management/organizations/:organizationId/environments/:environmentId/domains/:domain/themes/:themeId",
            "params": [
              {
                "name": "organizationId",
                "value": "",
                "type": "path"
              },
              {
                "name": "environmentId",
                "value": "",
                "type": "path"
              },
              {
                "name": "domain",
                "value": "",
                "type": "path"
              },
              {
                "name": "themeId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "User must have the DOMAIN_THEME[DELETE] permission on the specified domain or DOMAIN_THEME[DELETE] permission on the specified environment or DOMAIN_THEME[DELETE] permission on the specified organization"
        }
      ]
    }
  ],
  "bundled": true
}
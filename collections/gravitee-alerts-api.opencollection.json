              },
              {
                "name": "domain",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List all the alert triggers of the domain accessible to the current user. User must have DOMAIN_ALERT[LIST] permission on the specified domain, environment or organization."

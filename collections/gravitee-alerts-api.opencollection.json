                "value": "",
                "type": "path"
              },
              {
                "name": "environmentId",
                "value": "",
                "type": "path"
              },
              {
                "name": "domain",
                "value": "",
                "type": "path"
              },
              {
                "name": "notifierId",
                "value": "",
                "type": "path"
              }

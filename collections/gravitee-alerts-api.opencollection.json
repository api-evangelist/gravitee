      },
      "items": [
        {
          "info": {
            "name": "List alert notifiers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/management/organizations/:organizationId/environments/:environmentId/domains/:domain/alerts/notifiers",
            "params": [
              {
                "name": "organizationId",
                "value": "",
                "type": "path"
              },
              {
                "name": "environmentId",
                "value": "",
                "type": "path"
              },
              {
                "name": "domain",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List all the alert notifiers of the domain. User must have DOMAIN_ALERT_NOTIFIER[LIST] permission on the specified domain, environment or organization."
        },
        {
          "info": {
            "name": "Create an alert notifier",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "/management/organizations/:organizationId/environments/:environmentId/domains/:domain/alerts/notifiers",
            "params": [
              {
                "name": "organizationId",
                "value": "",
                "type": "path"
              },
              {
                "name": "environmentId",
                "value": "",
                "type": "path"
              },
              {
                "name": "domain",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new alert notifierUser must have DOMAIN_ALERT_NOTIFIER[CREATE] permission on the specified domain, environment or organization."
        },
        {
          "info": {
            "name": "Get an alert notifier",

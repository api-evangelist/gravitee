{
  "opencollection": "1.0.0",
  "info": {
    "name": "Gravitee.io - Access Management alerts dictionary API",
    "version": "4.12.0-alpha.3"
  },
  "items": [
    {
      "info": {
        "name": "dictionary",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all i18n dictionaries supported for a security domain",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/management/organizations/:organizationId/environments/:environmentId/domains/:domain/i18n/dictionaries",
            "params": [
              {
                "name": "organizationId",
                "value": "",
                "type": "path"
              },
              {
                "name": "environmentId",
                "value": "",
                "type": "path"
              },
              {
                "name": "domain",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "User must have the DOMAIN_I18N_DICTIONARY[LIST] permission on the specified domain or DOMAIN_I18N_DICTIONARY[LIST] permission on the specified environment or DOMAIN_I18N_DICTIONARY[LIST] permission on the specified organization."
        },
        {
          "info": {
            "name": "Create a new i18n dictionary for a supported language for a security domain",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "/management/organizations/:organizationId/environments/:environmentId/domains/:domain/i18n/dictionaries",
            "params": [
              {
                "name": "organizationId",
                "value": "",
                "type": "path"
              },
              {
                "name": "environmentId",
                "value": "",
                "type": "path"
              },
              {
                "name": "domain",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "User must have the DOMAIN_I18N_DICTIONARY[CREATE] permission on the specified domain or DOMAIN_I18N_DICTIONARY[CREATE] permission on the specified environment or DOMAIN_I18N_DICTIONARY[CREATE] permission on the specified organization."
        },
        {
          "info": {
            "name": "Get a i18n dictionary",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/management/organizations/:organizationId/environments/:environmentId/domains/:domain/i18n/dictionaries/:dictionary",
            "params": [
              {
                "name": "organizationId",
                "value": "",
                "type": "path"
              },
              {
                "name": "environmentId",
                "value": "",
                "type": "path"
              },
              {
                "name": "domain",
                "value": "",
                "type": "path"
              },
              {
                "name": "dictionary",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "User must have the DOMAIN_I18N_DICTIONARY[READ] permission on the specified domain or DOMAIN_I18N_DICTIONARY[READ] permission on the specified environment or DOMAIN_I18N_DICTIONARY[READ] permission on the specified organization."
        },
        {
          "info": {
            "name": "Update a i18n dictionary description",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "/management/organizations/:organizationId/environments/:environmentId/domains/:domain/i18n/dictionaries/:dictionary",
            "params": [
              {
                "name": "organizationId",
                "value": "",
                "type": "path"
              },
              {
                "name": "environmentId",
                "value": "",
                "type": "path"
              },
              {
                "name": "domain",
                "value": "",
                "type": "path"
              },
              {
                "name": "dictionary",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "User must have the DOMAIN_I18N_DICTIONARY[UPDATE] permission on the specified domain or DOMAIN_I18N_DICTIONARY[UPDATE] permission on the specified environment or DOMAIN_I18N_DICTIONARY[UPDATE] permission on the specified organization."
        },
        {
          "info": {
            "name": "Delete a i18n dictionary",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "/management/organizations/:organizationId/environments/:environmentId/domains/:domain/i18n/dictionaries/:dictionary",
            "params": [
              {
                "name": "organizationId",
                "value": "",
                "type": "path"
              },
              {
                "name": "environmentId",
                "value": "",
                "type": "path"
              },
              {
                "name": "domain",
                "value": "",
                "type": "path"
              },
              {
                "name": "dictionary",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "User must have the DOMAIN_I18N_DICTIONARY[DELETE] permission on the specified domain or DOMAIN_I18N_DICTIONARY[DELETE] permission on the specified environment or DOMAIN_I18N_DICTIONARY[DELETE] permission on the specified organization."
        },
        {
          "info": {
            "name": "Update all the entries for a i18n dictionary description",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "/management/organizations/:organizationId/environments/:environmentId/domains/:domain/i18n/dictionaries/:dictionary/entries",
            "params": [
              {
                "name": "organizationId",
                "value": "",
                "type": "path"
              },
              {
                "name": "environmentId",
                "value": "",
                "type": "path"
              },
              {
                "name": "domain",
                "value": "",
                "type": "path"
              },
              {
                "name": "dictionary",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "User must have the DOMAIN_I18N_DICTIONARY[UPDATE] permission on the specified domain or DOMAIN_I18N_DICTIONARY[UPDATE] permission on the specified environment or DOMAIN_I18N_DICTIONARY[UPDATE] permission on the specified organization."
        }
      ]
    }
  ],
  "bundled": true
}
{
  "opencollection": "1.0.0",
  "info": {
    "name": "Gravitee.io - Access Management alerts scope API",
    "version": "4.12.0-alpha.3"
  },
  "items": [
    {
      "info": {
        "name": "scope",
        "type": "folder"
      },

{
  "opencollection": "1.0.0",
  "info": {
    "name": "Gravitee.io - Access Management alerts Device Identifier API",
    "version": "4.12.0-alpha.3"
  },
  "items": [
    {
      "info": {
        "name": "Device Identifier",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List device identifier plugins",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/management/platform/plugins/device-identifiers"
          },
          "docs": "There is no particular permission needed. User must be authenticated."
        },
        {
          "info": {
            "name": "Get a device identifier plugin",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/management/platform/plugins/device-identifiers/:deviceIdentifier",
            "params": [
              {
                "name": "deviceIdentifier",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "There is no particular permission needed. User must be authenticated."
        },
        {
          "info": {
            "name": "Get a device identifier plugin's schema",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/management/platform/plugins/device-identifiers/:deviceIdentifier/schema",
            "params": [
              {
                "name": "deviceIdentifier",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "There is no particular permission needed. User must be authenticated."
        }
      ]
    }
  ],
  "bundled": true
}
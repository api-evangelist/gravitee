{
  "opencollection": "1.0.0",
  "info": {
    "name": "Gravitee.io - Access Management alerts sharding-tags API",
    "version": "4.12.0-alpha.3"
  },
  "items": [
    {
      "info": {
        "name": "sharding-tags",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List sharding tags",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/management/organizations/:organizationId/tags",
            "params": [
              {
                "name": "organizationId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "User must have the ORGANIZATION[LIST] permission on the specified organization. Each returned tag is filtered and contains only basic information such as id and name."
        },
        {
          "info": {
            "name": "Create a sharding tags",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "/management/organizations/:organizationId/tags",
            "params": [
              {
                "name": "organizationId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "User must have the ORGANIZATION_TAG[CREATE] permission on the specified organization"
        },
        {
          "info": {
            "name": "Get a sharding tag",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/management/organizations/:organizationId/tags/:tag",
            "params": [
              {
                "name": "organizationId",
                "value": "",
                "type": "path"
              },
              {
                "name": "tag",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "User must have the ORGANIZATION_TAG[READ] permission on the specified organization"
        },
        {
          "info": {
            "name": "Update the sharding tag",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "/management/organizations/:organizationId/tags/:tag",
            "params": [
              {
                "name": "organizationId",
                "value": "",
                "type": "path"
              },
              {
                "name": "tag",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "User must have the ORGANIZATION_TAG[UPDATE] permission on the specified organization"
        },
        {
          "info": {
            "name": "Delete the sharding tag",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "/management/organizations/:organizationId/tags/:tag",
            "params": [
              {
                "name": "organizationId",
                "value": "",
                "type": "path"
              },
              {
                "name": "tag",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "User must have the ORGANIZATION_TAG[DELETE] permission on the specified organization"
        }
      ]
    }
  ],
  "bundled": true
}